{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "General Proxy Manager",
  "version": "2.0.0",
  "identifier": "com.mahdn.general-proxy-manager",
  "build": {
    "beforeBuildCommand": "node -e \"const fs=require('fs'); fs.mkdirSync('dist', {recursive: true}); ['index.html','main.js','core-generator.js','locales.js','sing-box-template.json.tpl','favicon.ico','en.yml','fa.yml','zh.yml'].forEach(f => fs.existsSync(f) && fs.copyFileSync(f, 'dist/' + f)); if(fs.existsSync('img')) fs.cpSync('img', 'dist/img', {recursive: true});\"",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "General Proxy Manager v2.0",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/sing-box"
    ]
  }
}
